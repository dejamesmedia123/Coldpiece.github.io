const COMPANY_NAME='COLDPIECE'; /* EDIT: used for the database sheet name */
function db(){const p=PropertiesService.getScriptProperties(),id=p.getProperty('SSID');if(id)return SpreadsheetApp.openById(id);const ss=SpreadsheetApp.create(COMPANY_NAME+' DB');p.setProperty('SSID',ss.getId());if(!p.getProperty('ADMIN_EMAIL'))p.setProperty('ADMIN_EMAIL',Session.getEffectiveUser().getEmail());const pl=ss.getSheets()[0];pl.setName('Plans');pl.appendRow(['id','name','min','max','roi','days','status']);[[1,'Starter',100,999,5,7,'active'],[2,'Growth',1000,4999,12,14,'active'],[3,'Premier',5000,50000,25,30,'active']].forEach(r=>pl.appendRow(r));ss.insertSheet('Applications').appendRow(['time','name','email','phone','plan','amount','note']);ss.insertSheet('Messages').appendRow(['time','name','email','message']);return ss}function out(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}function doGet(){const v=db().getSheetByName('Plans').getDataRange().getValues(),h=v.shift();return out(v.map(r=>Object.fromEntries(h.map((k,i)=>[k,r[i]]))).filter(p=>p.status==='active'))}function esc(x){return String(x).split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;')}function notify(c){try{const to=PropertiesService.getScriptProperties().getProperty('ADMIN_EMAIL')||Session.getEffectiveUser().getEmail(),rows=[['Name',c.name],['Email',c.email],['Phone',c.phone],['Plan',c.plan],['Amount',c.amount],['Note',c.note],['Received',new Date().toUTCString()]];MailApp.sendEmail({to:to,replyTo:c.email,subject:'New member: '+c.name+' ('+c.plan+')',body:rows.map(r=>r[0]+': '+(r[1]||'-')).join('\n'),htmlBody:'<h2>New member joined</h2><table cellpadding=8 style="border-collapse:collapse;font-family:sans-serif">'+rows.map(r=>'<tr><td style="border:1px solid #ddd;background:#f3f7f5"><b>'+r[0]+'</b></td><td style="border:1px solid #ddd">'+esc(r[1]||'-')+'</td></tr>').join('')+'</table>'})}catch(x){}}function doPost(e){const l=LockService.getScriptLock();l.waitLock(10000);try{const d=JSON.parse(e.postData.contents),s=x=>String(x||'').slice(0,500),f=x=>s(x).split('\n').join(' ').split('\r').join(' '),ss=db(),n=f(d.name),m=f(d.email);if(!n||m.indexOf('@')<0)return out({ok:false,error:'Name and email are required.'});if(d.type==='apply'){const c={name:n,email:m,phone:f(d.phone),plan:f(d.plan),amount:Number(d.amount)||0,note:s(d.note)};ss.getSheetByName('Applications').appendRow([new Date(),c.name,c.email,c.phone,c.plan,c.amount,c.note]);notify(c)}else if(d.type==='contact')ss.getSheetByName('Messages').appendRow([new Date(),n,m,s(d.message)]);else return out({ok:false,error:'Unknown request.'});return out({ok:true})}catch(x){return out({ok:false,error:'Server error.'})}finally{l.releaseLock()}}